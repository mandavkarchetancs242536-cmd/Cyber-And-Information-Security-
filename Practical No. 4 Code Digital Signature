# CLI MODE
from cryptography.hazmat.primitives.asymmetric import rsa, padding
from cryptography.hazmat.primitives import hashes
import base64


private_key = rsa.generate_private_key(
    public_exponent=65537,
    key_size=2048
)

public_key = private_key.public_key()


message = input("Enter Message: ").encode()


signature = private_key.sign(
    message,
    padding.PKCS1v15(),
    hashes.SHA256()
)

print("\nOriginal Message:", message.decode())
print("Digital Signature:", base64.b64encode(signature).decode())


verify_message = input("\nEnter Message Again For Verification: ").encode()


try:
    public_key.verify(
        signature,
        verify_message,
        padding.PKCS1v15(),
        hashes.SHA256()
    )

    print("\nSignature Verification: SUCCESS")
    print("Message is Authentic and Has Not Been Modified")

except Exception:
    print("\nSignature Verification: FAILED")
    print("Message is Not Authentic or Has Been Modified")





# GUI MODE
import tkinter as tk
from tkinter import messagebox
from cryptography.hazmat.primitives.asymmetric import rsa, padding
from cryptography.hazmat.primitives import hashes
import base64



private_key = rsa.generate_private_key(
    public_exponent=65537,
    key_size=2048
)

public_key = private_key.public_key()




def sign_message():

    message = message_entry.get().strip()

    if not message:
        messagebox.showwarning(
            "Input Required",
            "Please enter a message first."
        )
        return

    message_bytes = message.encode()

    signature = private_key.sign(
        message_bytes,
        padding.PKCS1v15(),
        hashes.SHA256()
    )

    signature_text = base64.b64encode(signature).decode()

    signature_entry.delete("1.0", tk.END)
    signature_entry.insert(tk.END, signature_text)

    status_label.config(
        text="●  SIGNATURE GENERATED SUCCESSFULLY",
        fg="#00e676"
    )

    status_detail.config(
        text="The message has been digitally signed using the RSA private key.",
        fg="#9aa4b2"
    )


def verify_signature():

    message = message_entry.get().strip()

    signature_text = signature_entry.get("1.0", tk.END).strip()

    if not message:
        messagebox.showwarning(
            "Input Required",
            "Please enter a message."
        )
        return

    if not signature_text:
        messagebox.showwarning(
            "Signature Required",
            "Please generate or enter a digital signature."
        )
        return

    try:

        signature = base64.b64decode(signature_text)

        public_key.verify(
            signature,
            message.encode(),
            padding.PKCS1v15(),
            hashes.SHA256()
        )

        status_label.config(
            text="✓  SIGNATURE VERIFIED",
            fg="#00e676"
        )

        status_detail.config(
            text="Message is authentic and has not been modified.",
            fg="#9aa4b2"
        )

    except Exception:

        status_label.config(
            text="✗  SIGNATURE VERIFICATION FAILED",
            fg="#ff5252"
        )

        status_detail.config(
            text="Message is not authentic or has been modified.",
            fg="#9aa4b2"
        )


def clear_fields():

    message_entry.delete(0, tk.END)

    signature_entry.delete("1.0", tk.END)

    status_label.config(
        text="●  READY",
        fg="#00bcd4"
    )

    status_detail.config(
        text="Enter a message and generate a digital signature.",
        fg="#9aa4b2"
    )




