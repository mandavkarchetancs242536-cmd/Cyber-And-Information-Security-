# RSA ENCRYPTION AND DECRYPTION CLI MODE

import math


def gcd(a, b):
    while b != 0:
        a, b = b, a % b
    return a


def mod_inverse(e, phi):
    for d in range(1, phi):
        if (d * e) % phi == 1:
            return d
    return None


def generate_keys():
    p = 17
    q = 11

    n = p * q
    phi = (p - 1) * (q - 1)

    e = 7
    while gcd(e, phi) != 1:
        e += 1

    d = mod_inverse(e, phi)

    return (e, n), (d, n)


def encrypt(public_key, message):
    e, n = public_key
    cipher = []

    for char in message:
        cipher.append(pow(ord(char), e, n))

    return cipher


def decrypt(private_key, cipher):
    d, n = private_key
    text = ""

    for num in cipher:
        text += chr(pow(num, d, n))

    return text


public_key, private_key = generate_keys()

print("========== RSA Encryption ==========")
print("Public Key :", public_key)
print("Private Key:", private_key)

message = input("\nEnter Message: ")

cipher = encrypt(public_key, message)

print("\nEncrypted Message:")
print(cipher)

plain = decrypt(private_key, cipher)

print("\nDecrypted Message:")
print(plain)



