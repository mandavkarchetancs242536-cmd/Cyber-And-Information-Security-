# CLI VERSION
import hmac
import hashlib

print("=" * 55)
print("MESSAGE AUTHENTICATION CODE (HMAC - SHA256)")
print("=" * 55)


secret_key = input("Enter Secret Key: ").encode()


message = input("Enter Message: ").encode()


mac = hmac.new(secret_key, message, hashlib.sha256).hexdigest()

print("\nGenerated MAC:")
print(mac)

print("\n------ Verification ------")

received_message = input("Enter Message to Verify: ").encode()
received_mac = input("Enter Received MAC: ")

new_mac = hmac.new(secret_key, received_message, hashlib.sha256).hexdigest()

if hmac.compare_digest(new_mac, received_mac):
    print("\n✅ MAC Verified Successfully!")
    print("Data Integrity Maintained.")
    print("Message is Authentic.")
else:
    print("\n❌ MAC Verification Failed!")
    print("Message has been Modified or Key is Incorrect.")



# GUI VERSION
import tkinter as tk
from tkinter import messagebox
import hmac
import hashlib



def generate_mac():
    key = entry_key.get().strip().encode()
    msg = txt_message.get("1.0", tk.END).strip().encode()

    if not key or not msg:
        messagebox.showerror("Error", "Please enter Secret Key and Message.")
        return

    mac = hmac.new(key, msg, hashlib.sha256).hexdigest()

    txt_mac.config(state="normal")
    txt_mac.delete("1.0", tk.END)
    txt_mac.insert(tk.END, mac)
    txt_mac.config(state="disabled")


