def copy_mac():
    txt = txt_mac.get("1.0", tk.END).strip()

    if txt == "":
        return

    root.clipboard_clear()
    root.clipboard_append(txt)

    messagebox.showinfo("Copied", "Generated MAC copied to Clipboard.")


def clear_all():
    entry_key.delete(0, tk.END)

    txt_message.delete("1.0", tk.END)
    txt_mac.config(state="normal")
    txt_mac.delete("1.0", tk.END)
    txt_mac.config(state="disabled")

    txt_verify_message.delete("1.0", tk.END)
    txt_received_mac.delete("1.0", tk.END)

    lbl_result.config(text="")




