# GUI MODE
import tkinter as tk
from tkinter import messagebox


def calculate_exchange():

    try:
        p = int(p_entry.get())
        g = int(g_entry.get())

        alice_private = int(alice_private_entry.get())
        bob_private = int(bob_private_entry.get())

        if p <= 1 or g <= 0:
            messagebox.showwarning(
                "Invalid Input",
                "Please enter valid values for p and g."
            )
            return

        if alice_private <= 0 or bob_private <= 0:
            messagebox.showwarning(
                "Invalid Private Key",
                "Private keys must be positive numbers."
            )
            return

        
        alice_public = pow(g, alice_private, p)
        bob_public = pow(g, bob_private, p)

        
        alice_shared = pow(
            bob_public,
            alice_private,
            p
        )

        bob_shared = pow(
            alice_public,
            bob_private,
            p
        )

        
        alice_public_entry.config(state="normal")
        alice_public_entry.delete(0, tk.END)
        alice_public_entry.insert(0, str(alice_public))
        alice_public_entry.config(state="readonly")

        
        bob_public_entry.config(state="normal")
        bob_public_entry.delete(0, tk.END)
        bob_public_entry.insert(0, str(bob_public))
        bob_public_entry.config(state="readonly")

        
        alice_shared_entry.config(state="normal")
        alice_shared_entry.delete(0, tk.END)
        alice_shared_entry.insert(0, str(alice_shared))
        alice_shared_entry.config(state="readonly")

        
        bob_shared_entry.config(state="normal")
        bob_shared_entry.delete(0, tk.END)
        bob_shared_entry.insert(0, str(bob_shared))
        bob_shared_entry.config(state="readonly")

       
        global original_alice_shared
        global original_bob_shared

        original_alice_shared = alice_shared
        original_bob_shared = bob_shared

        
        if alice_shared == bob_shared:

            status_title.config(
                text="KEY EXCHANGE SUCCESSFUL",
                fg="#16803c"
            )

            status_message.config(
                text="Alice and Bob have generated the same shared secret.",
                fg="#4b5563"
            )

            status_icon.config(
                text="✓",
                fg="#16803c"
            )


    except ValueError:

        messagebox.showerror(
            "Invalid Input",
            "Please enter numbers only."
        )



def failed_test():

    try:

        alice_secret = int(alice_shared_entry.get())
        bob_secret = int(bob_shared_entry.get())

        if not alice_secret or not bob_secret:
            messagebox.showwarning(
                "No Key Available",
                "First generate the shared key."
            )
            return

        
        modified_bob_secret = bob_secret + 1

        bob_shared_entry.config(state="normal")
        bob_shared_entry.delete(0, tk.END)
        bob_shared_entry.insert(0, str(modified_bob_secret))
        bob_shared_entry.config(state="readonly")

       
        if alice_secret == modified_bob_secret:

            status_icon.config(
                text="✓",
                fg="#16803c"
            )

            status_title.config(
                text="KEY EXCHANGE SUCCESSFUL",
                fg="#16803c"
            )

            status_message.config(
                text="The shared secrets match.",
                fg="#4b5563"
            )

        else:

            status_icon.config(
                text="✕",
                fg="#c62828"
            )

            status_title.config(
                text="KEY EXCHANGE FAILED",
                fg="#c62828"
            )

            status_message.config(
                text="Shared secrets do not match. Tampering detected.",
                fg="#4b5563"
            )

    except ValueError:

        messagebox.showwarning(
            "Verification Error",
            "Generate the shared key first."
        )



def clear_all():

    alice_private_entry.delete(0, tk.END)
    bob_private_entry.delete(0, tk.END)

    alice_public_entry.config(state="normal")
    alice_public_entry.delete(0, tk.END)
    alice_public_entry.config(state="readonly")

    bob_public_entry.config(state="normal")
    bob_public_entry.delete(0, tk.END)
    bob_public_entry.config(state="readonly")

    alice_shared_entry.config(state="normal")
    alice_shared_entry.delete(0, tk.END)
    alice_shared_entry.config(state="readonly")

    bob_shared_entry.config(state="normal")
    bob_shared_entry.delete(0, tk.END)
    bob_shared_entry.config(state="readonly")

    status_icon.config(
        text="●",
        fg="#7c3aed"
    )

    status_title.config(
        text="READY FOR KEY EXCHANGE",
        fg="#7c3aed"
    )

    status_message.config(
        text="Enter the private keys and generate the shared secret.",
        fg="#4b5563"
    )



